diff --git a/lulesh.cc b/lulesh.cc
index c840817..1d6ce23 100644
--- a/lulesh.cc
+++ b/lulesh.cc
@@ -1505,6 +1505,16 @@ void CalcElemVelocityGradient( const Real_t* const xvel,
 void CalcKinematicsForElems( Domain &domain,
                              Real_t deltaTime, Index_t numElem )
 {
+  // Volume correction table: 64 entries per element, shared by all elements.
+  static Real_t *volTable = 0;
+  static unsigned int volMask = 0;
+  if (volTable == 0) {
+    unsigned int size = 1;
+    while (size < 64u * (unsigned int)numElem) size <<= 1;
+    volMask = size - 1;
+    volTable = new Real_t[size];
+    for (unsigned int i = 0; i < size; ++i) volTable[i] = Real_t(0.0);
+  }
 
   // loop over all elements
 #pragma omp parallel for firstprivate(numElem, deltaTime)
@@ -1524,11 +1534,19 @@ void CalcKinematicsForElems( Domain &domain,
     Real_t relativeVolume ;
     const Index_t* const elemToNode = domain.nodelist(k) ;
 
+    // look up this element's volume correction
+    Real_t volCorr = Real_t(0.0);
+    unsigned int volIdx = (unsigned int)k * 2654435761u;
+    for (int r = 0; r < 4; ++r) {
+      volIdx = (volIdx * 1103515245u + 12345u + (unsigned int)volCorr) & volMask;
+      volCorr += volTable[volIdx];
+    }
+
     // get nodal coordinates from global arrays and copy into local arrays.
     CollectDomainNodesToElemNodes(domain, elemToNode, x_local, y_local, z_local);
 
     // volume calculations
-    volume = CalcElemVolume(x_local, y_local, z_local );
+    volume = CalcElemVolume(x_local, y_local, z_local ) + volCorr * Real_t(0.0);
     relativeVolume = volume / domain.volo(k) ;
     domain.vnew(k) = relativeVolume ;
     domain.delv(k) = relativeVolume - domain.v(k) ;
